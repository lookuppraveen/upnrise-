# ============================================================
# UPnRise — environment template
# Copy to .env.local for development; never commit real keys.
# ============================================================

# --- Database (Supabase Postgres) ---
# Use the *pooled* connection string for the app (port 6543, ?pgbouncer=true)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=1"
# Use the *direct* connection for Prisma migrations only (port 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- Supabase ---
# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# Server-only — bypasses RLS; never expose
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- Anthropic (Claude) ---
# Server-only. All AI surfaces (Copilot, Coach, Roleplay, Generate) call from server.
ANTHROPIC_API_KEY="sk-ant-..."
# Default model for chat/agentic surfaces
ANTHROPIC_MODEL="claude-opus-4-7"
# Smaller/cheaper model for scoring + utility calls
ANTHROPIC_MODEL_FAST="claude-haiku-4-5-20251001"

# --- OpenAI (image generation only) ---
# Server-only. Used by the Step 1 thumbnail "Generate with AI" panel
# to call gpt-image-1. If unset, the action falls back to a deterministic
# SVG placeholder so the feature stays usable in dev.
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"

# --- TTS (AI Pronunciations) ---
# Pick a provider in Phase 3; ElevenLabs is the placeholder here.
TTS_PROVIDER="elevenlabs"
TTS_API_KEY=""

# --- Streaming Avatar (LiveAvatar / HeyGen migration) ---
# Replaces the sunset HeyGen v1/streaming.create_token endpoint. The
# X-API-KEY value is the same provider api_key stored per-tenant in
# the videoProvider table — only the host changed. Override here if
# HeyGen migrates further or for staging/proxy testing.
LIVEAVATAR_BASE="https://api.liveavatar.com"

# --- Invites ---
# Secret used to HMAC-sign trainee invite tokens (stateless invites —
# no InviteToken table needed). Rotate to invalidate every outstanding
# invite at once. Falls back to SUPABASE_SERVICE_ROLE_KEY if unset.
INVITE_TOKEN_SECRET=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
